# Copy to .env.local for development. In production these are Railway variables.

# --- Supabase (required) ---------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses row-level security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Bottle research (optional) --------------------------------------------
# Powers "scan a bottle" in the admin panel. Without it, bottles are entered by
# hand and the scan button reports that research is unconfigured.
ANTHROPIC_API_KEY=sk-ant-...

# --- Email (optional) ------------------------------------------------------
# Supabase sends auth and invitation email on its own. Resend is for the
# event and fitting notices.
RESEND_API_KEY=re_...

# --- Seeding (optional) ----------------------------------------------------
# Password given to every seeded demo account. Change it before seeding
# anything reachable from the internet.
SEED_PASSWORD=subourbon-demo-2026
